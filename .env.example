# VECU-Twin Environment Configuration
# Copy this file to .env and adjust values as needed.

# --- Simulation Mode ---
# Set to "true" to run Python-only simulation (no C++ binary required)
# Set to "false" to connect to the C++ vecu_sim binary
STANDALONE_MODE=true

# --- Database ---
DATABASE_PATH=./data/vecu_twin.db

# --- C++ Simulator TCP Stream ---
# The C++ simulator streams live CAN frames on this host:port
SIM_HOST=127.0.0.1
SIM_PORT=8765

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./data/logs/backend.log

# --- Config Paths ---
VEHICLE_CONFIG=./config/vehicle.json
ECU_CONFIG=./config/ecu_config.json
CAN_MESSAGES_CONFIG=./config/can_messages.json
FAULT_CONFIG=./config/fault_config.json
